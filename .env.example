# ==============================================================
# Azure Presale Studio — environment variables
# Copy to .env.local for local development. Never commit .env.local
# ==============================================================

# ── Database ────────────────────────────────────────────────
# Postgres connection string
DATABASE_URL="postgresql://presale:presale_dev_pw@localhost:5432/azure_presale"

# ── Session ─────────────────────────────────────────────────
# 64-byte hex secret for session cookie signing (generate: openssl rand -hex 64)
SESSION_SECRET="changeme_generate_with_openssl_rand_hex_64"

# ── NIM key encryption ───────────────────────────────────────
# 32-byte hex key for AES-256-GCM encryption of stored NIM keys
# (generate: openssl rand -hex 32)
NIM_ENCRYPTION_KEY="changeme_generate_with_openssl_rand_hex_32"

# ── NIM / NVIDIA API ─────────────────────────────────────────
# Base URL for NVIDIA NIM (OpenAI-compatible endpoint)
NIM_BASE_URL="https://integrate.api.nvidia.com/v1"

# ── App ──────────────────────────────────────────────────────
# Cookie domain (leave empty for localhost)
COOKIE_DOMAIN=""
# Node environment
NODE_ENV="development"
